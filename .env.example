# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real secrets.

# --- Infra (defaults match docker-compose.yml, override only if different) -
# MongoDB must be a replica set (compose runs a single-node one);
# directConnection because the member advertises its in-container host.
# MONGODB_URL=mongodb://localhost:27018/?directConnection=true
# MONGODB_DB=npe_triage_rca
# ChromaDB (RAG vectors, derived from Mongo -- rebuild with
# `uv run python -m scripts.rebuild_vector_index`). Only the LLM features use it.
# CHROMA_HOST=localhost
# CHROMA_PORT=8011
# CHROMA_SSL=false
# CHROMA_AUTH_TOKEN=
# CHROMA_COLLECTION_PREFIX=npe_
# REDIS_URL=redis://localhost:6380/0
# RABBITMQ_URL=amqp://guest:guest@localhost:5673/
# OPA_URL=http://localhost:8182

# --- Jira Cloud ----------------------------------------------------------------
# Site is the hostname only, no scheme -- e.g. npetriage.atlassian.net
JIRA_SITE=npetriage.atlassian.net
# The Atlassian account email the API token belongs to.
JIRA_EMAIL=
# Generate at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# --- Microsoft Graph / Teams -----------------------------------------------
# Requires an Azure AD app registration with application permissions
# (ChannelMessage.Read.All, Channel.ReadBasic.All, Team.ReadBasic.All) and
# admin consent.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
TEAMS_TEAM_ID=
TEAMS_CHANNEL_ID=

# --- Poller tuning -----------------------------------------------------------
# POLL_INTERVAL_SECONDS=300
# POLL_LOOKBACK_MINUTES=30

# --- LLM fallback classification + RCA synthesis ----------------------------
# No real key provisioned. Both LLM_FALLBACK_ENABLED and
# RCA_SYNTHESIS_LLM_ENABLED default to false, so an empty key here is fine
# until you're ready to activate either feature.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=1536

# LLM_FALLBACK_ENABLED=false
# CLASSIFICATION_CONFIDENCE_THRESHOLD=0.7
# RCA_SYNTHESIS_LLM_ENABLED=false
# RAG_EMBED_FEEDBACK_ONLY=true
# RAG_RETENTION_MONTHS=6
# Unset keeps every incident classification vector; set to have the sweeper prune older ones.
# RAG_CLASSIFICATION_RETENTION_MONTHS=
